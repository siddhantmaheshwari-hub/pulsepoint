# --- Neon Postgres (server-side only; never prefix with NEXT_PUBLIC_) ---
# Use the POOLED connection string (host contains "-pooler"), with sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Gemini Flash (Google AI Studio key) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Minimum ms between Gemini calls (free tier friendly)
GEMINI_MIN_INTERVAL_MS=4000

# --- Security ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when this is set
CRON_SECRET=

# --- Optional sources ---
# Raises Stack Exchange quota from 300 to 10,000 requests/day (not a secret, but keep server-side)
STACKEXCHANGE_KEY=
# Enables GitHub Issues search (also set sources.is_enabled = true for 'github')
GITHUB_TOKEN=

# --- Reporting ---
# Report timezone offset in minutes from UTC (330 = IST). Weekly windows end at local midnight.
REPORT_TZ_OFFSET_MINUTES=330
# Total time budget per pipeline invocation (ms). Keep below the function maxDuration (300s).
PIPELINE_BUDGET_MS=240000
# Optional Slack incoming webhook for the Friday brief notification
SLACK_WEBHOOK_URL=
# Public URL of the deployed app, used in notifications
APP_URL=

# --- Friday brief email (Resend) ---
# API key from resend.com → API Keys. Without a verified domain, Resend only delivers to your own sign-up address.
RESEND_API_KEY=
# Comma-separated recipients
BRIEF_RECIPIENTS=
# Sender; the default works without a verified domain
BRIEF_FROM=PulsePoint <onboarding@resend.dev>

# --- Team votes ---
# Comma-separated names offered in "Who are you?" when voting on AI findings
TEAM_MEMBERS=Sumit,Neha,Kabir

# --- Failure alerts ---
# Named maintainer emailed (via Resend) when a scheduled run fails or a source fails 3 runs in a row; max once per problem per day
ALERT_EMAIL=
